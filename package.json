{
  "name": "@xtruder/opencode-history-search",
  "version": "1.5.1",
  "description": "Search OpenCode conversation history across all projects or current repo — trace which prompts touched specific files",
  "keywords": [
    "conversation",
    "fuzzy-search",
    "history",
    "opencode",
    "search",
    "tool"
  ],
  "homepage": "https://github.com/xtruder/opencode-history-search#readme",
  "bugs": {
    "url": "https://github.com/xtruder/opencode-history-search/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/xtruder/opencode-history-search.git"
  },
  "files": [
    "index.js",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "scripts": {
    "test": "npm run build && npm run test:unit",
    "test:unit": "vitest run src",
    "test:integration": "npm run build && node test/integration.ts",
    "test:all": "npm run build && npm run test:unit && node test/integration.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/client": "2.0.16",
    "@opencode/util": "^2.0.16",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.16",
    "@types/node": "^26.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "opencode": ">=2.0.16 <3"
  }
}
